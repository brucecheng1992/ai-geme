{
  "contract_version": "mechanic-contract-v0.1",
  "genre": "dodger",
  "required_mechanics": [
    "player.can_move",
    "hazard.exists",
    "hazard.spawn",
    "collision.player_hits_hazard",
    "player.damaged_or_game_lost",
    "win.survive_duration"
  ],
