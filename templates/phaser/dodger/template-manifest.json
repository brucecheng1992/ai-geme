{
  "template_id": "dodger_v1",
  "genre": "dodger",
  "runtime": "phaser",
  "required_systems": [
    "InputSystem",
    "MovementSystem",
    "SpawnSystem",
    "CollisionSystem",
    "ScoreSystem",
    "ObjectiveSystem",
    "TelemetrySystem",
    "GameStateSystem",
    "QaBridge"
  ],
  "parameter_contract": "DodgerTemplateParams",
  "deterministic_qa": true,
  "source_files": [
    "src/main.ts",
    "src/GameScene.ts",
    "src/dodger-art-library.ts",
    "src/dodger-runtime-plan.ts",
    "src/asset-manifest.generated.json",
    "src/runtime-plan.generated.json",
    "src/template-params.ts",
    "src/template-params.generated.json"
  ],
  "shared_files": ["../shared/kernel.ts"],
  "required_telemetry_all": [
    "game.started",
    "input.received",
    "player.moved",
    "hazard.spawned",
    "game.restarted"
  ],
  "required_telemetry_any_groups": [
    ["collision.detected", "player.damaged"],
    ["survival_time.changed", "game.lost"]
  ]
}
