{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-maker.local/schemas/ai-game-art-asset-metadata.v0.1.schema.json",
  "title": "AI Game Art Asset Metadata v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "asset_type",
    "asset_subtype",
    "title",
    "description",
    "version",
    "status",
    "semantic",
    "gameplay",
    "technical",
    "ai_generation",
    "rights",
    "workflow"
  ],
  "properties": {
    "asset_id": {
      "$ref": "#/$defs/asset_metadata_id"
    },
    "project_code": {
      "$ref": "#/$defs/slug"
    },
    "asset_type": {
      "$ref": "#/$defs/asset_type"
    },
    "asset_subtype": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "status": {
      "$ref": "#/$defs/workflow_status"
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "semantic_tags", "visual_style"],
      "properties": {
        "world": {
          "$ref": "#/$defs/slug"
        },
        "genre": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/slug" }
        },
        "subject": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/slug" }
        },
        "semantic_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/slug" }
        },
        "visual_style": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/visual_style" }
        },
        "mood": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/mood" }
        },
        "color_palette": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/slug" }
        },
        "dominant_colors": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameplay_role", "affordances", "allowed_contexts", "blocked_contexts"],
      "properties": {
        "gameplay_role": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/gameplay_role" }
        },
        "affordances": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/affordance" }
        },
        "biome": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/slug" }
        },
        "faction": {
          "anyOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }]
        },
        "rarity": {
          "$ref": "#/$defs/rarity"
        },
        "spawnable": {
          "type": "boolean"
        },
        "allowed_contexts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/slug" }
        },
        "blocked_contexts": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/slug" }
        },
        "interaction_type": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "thumbnail_path", "file_format"],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/project_relative_path"
        },
        "thumbnail_path": {
          "$ref": "#/$defs/project_relative_path"
        },
        "file_format": {
          "$ref": "#/$defs/file_format"
        },
        "engine_targets": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/slug" }
        },
        "polycount_lod0": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "texture_resolution": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 40
        },
        "platform_budget": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "ai_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by_ai"],
      "properties": {
        "generated_by_ai": { "type": "boolean" },
        "ai_system_used": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
        "ai_system_version": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
        "prompt_summary": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "negative_prompt_summary": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "seed": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
        "human_edit_level": { "$ref": "#/$defs/human_edit_level" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator", "license", "commercial_use", "training_use_allowed", "rights_risk_level"],
      "properties": {
        "creator": { "type": "string", "minLength": 1, "maxLength": 120 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 120 },
        "license": { "$ref": "#/$defs/license_type" },
        "commercial_use": { "type": "boolean" },
        "training_use_allowed": { "type": "boolean" },
        "third_party_sources": {
          "type": "array",
          "maxItems": 24,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "rights_risk_level": { "$ref": "#/$defs/rights_risk_level" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "updated_at"],
      "properties": {
        "owner": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reviewed_by": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
        "review_notes": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "created_at": { "$ref": "#/$defs/date_string" },
        "updated_at": { "$ref": "#/$defs/date_string" },
        "approved_at": {
          "anyOf": [{ "$ref": "#/$defs/date_string" }, { "type": "null" }]
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant_of": {
          "anyOf": [{ "$ref": "#/$defs/asset_metadata_id" }, { "type": "null" }]
        },
        "derived_from": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/asset_metadata_id" }
        },
        "depends_on": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/asset_metadata_id" }
        },
        "compatible_with": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/asset_metadata_id" }
        },
        "used_by": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "embedding_input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  },
  "$defs": {
    "asset_metadata_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)+_[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "date_string": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "project_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?!.*(?:^|/)\\.\\.?($|/))[^/]+(?:/[^/]+)*$"
    },
    "asset_type": {
      "type": "string",
      "enum": ["concept_art", "character", "creature", "environment", "prop", "weapon", "vehicle", "ui", "icon", "vfx", "material", "texture", "animation", "rig", "prefab", "tile", "skybox", "reference"]
    },
    "visual_style": {
      "type": "string",
      "enum": ["realistic", "semi_realistic", "stylized", "anime", "pixel_art", "low_poly", "voxel", "hand_painted", "painterly", "comic", "toon", "dark_fantasy", "cozy_fantasy", "cyberpunk", "steampunk", "sci_fi"]
    },
    "mood": {
      "type": "string",
      "enum": ["friendly", "cute", "warm", "mysterious", "dangerous", "heroic", "sad", "ominous", "luxurious", "ancient", "magical", "industrial", "ruined", "peaceful", "chaotic"]
    },
    "gameplay_role": {
      "type": "string",
      "enum": ["npc", "player_character", "vendor", "quest_giver", "enemy", "ally", "loot_container", "cover", "decoration", "environment", "ui", "icon", "material", "texture", "collectible", "projectile"]
    },
    "affordance": {
      "type": "string",
      "enum": ["talkable", "trading", "idle_animation", "collectible", "equipable", "crafting_material", "destructible", "container", "cover", "climbable", "walkable", "interactable", "quest_item", "ambient", "decorative", "animated", "physics_object", "inventory_action", "texture_source", "material_source"]
    },
    "workflow_status": {
      "type": "string",
      "enum": ["idea", "generated", "selected", "in_paintover", "in_modeling", "in_texturing", "in_rigging", "in_animation", "in_engine", "needs_review", "approved", "deprecated", "rejected", "archived"]
    },
    "license_type": {
      "type": "string",
      "enum": ["internal_project_only", "cc0", "cc_by", "cc_by_sa", "commercial", "unknown"]
    },
    "human_edit_level": {
      "type": "string",
      "enum": ["ai_generated", "paintover_minor", "paintover_major", "human_made", "unknown"]
    },
    "rights_risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "blocked", "unknown"]
    },
    "file_format": {
      "type": "string",
      "enum": ["png", "jpg", "jpeg", "webp", "svg", "fbx", "glb", "gltf", "uasset", "material", "json"]
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "epic", "legendary"]
    }
  }
}
