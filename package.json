{
  "name": "ai-game-maker-p0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/runtime-adapters/*"
  ],
  "scripts": {
    "maker:setup": "node scripts/setup.mjs",
    "maker:doctor": "node scripts/doctor.mjs",
    "maker:start": "npm run maker:setup && node scripts/dev.mjs",
    "maker:clean": "node scripts/clean.mjs",
    "test": "npm run test:contracts && npm run test:workspace",
    "test:contracts": "vitest run tests/contracts",
    "test:workspace": "vitest run tests/workspace",
    "qa:asset-semantic:canary": "tsx scripts/run-asset-semantic-canary.ts",
    "qa:asset-semantic:compare": "tsx scripts/compare-asset-semantic-canaries.ts",
    "minimax:smoke": "tsx scripts/minimax-smoke.ts",
    "art-task:mock": "tsx scripts/art-task-mock.ts",
    "art-task:minimax-smoke": "tsx scripts/art-task-minimax-smoke.ts",
    "art-task:minimax-same-run-smoke": "tsx scripts/art-task-minimax-smoke.ts",
    "art-task:batch-001": "tsx scripts/art-task-batch-001.ts",
    "art-task:batch-002": "tsx scripts/art-task-batch-002.ts",
    "art-task:batch-002b": "tsx scripts/art-task-batch-002b.ts",
    "art-task:batch-002c": "tsx scripts/art-task-batch-002c.ts",
    "metadata:validate": "tsx scripts/validate-art-asset-metadata.ts",
    "metadata:export-runtime": "tsx scripts/export-art-runtime-metadata.ts",
    "typecheck": "npm run typecheck:root && npm run typecheck --workspace @ai-game-maker/maker-api && npm run typecheck --workspace @ai-game-maker/maker-workbench",
    "typecheck:root": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "phaser": "^3.90.0",
    "playwright": "^1.60.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.6"
  }
}
